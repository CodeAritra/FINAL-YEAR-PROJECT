# ==============================================================================
# Multi-Layer Security Framework for RAG Systems - Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your actual API keys and endpoints.
# NEVER commit .env to version control!

# --- System & Execution Settings ---
APP_ENV=development                # development | production | test
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DEVICE=cpu                         # cpu | cuda (Keep 'cpu' for 8 GB RAM profile)

# --- Vector Database (Qdrant Cloud) ---
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION_BASELINE=baseline_rag
QDRANT_COLLECTION_SECURED=secured_rag

# --- Embedding Model (Sentence Transformers) ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Primary LLM Provider (Qwen2.5 / OpenAI-compatible / Ollama) ---
# Options: ollama_cloud | openai_compatible | local_ollama | mock
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=https://api.together.xyz/v1 # Or Ollama host / OpenRouter / Groq / OpenAI
LLM_API_KEY=your-llm-api-key
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Prompt Injection Classifier (ProtectAI DeBERTa v3 / Hosted API) ---
# Options: hosted_hf | mock
PROMPT_INJECTION_PROVIDER=mock
HF_API_KEY=your-huggingface-api-key
DEBERTA_API_URL=https://api-inference.huggingface.co/models/ProtectAI/deberta-v3-base-prompt-injection-v2

# --- Harmful Content Classifier (Meta Llama Guard 3 1B) ---
# Options: hosted_api | mock
LLAMA_GUARD_PROVIDER=mock
LLAMA_GUARD_API_URL=https://api.together.xyz/v1
LLAMA_GUARD_API_KEY=your-llama-guard-api-key
LLAMA_GUARD_MODEL=meta-llama/Llama-Guard-3-1b

# --- Local Guardrail Modules ---
ENABLE_PRESIDIO=true
PRESIDIO_LANGUAGE=en
ENABLE_SECRET_REGEX=true

