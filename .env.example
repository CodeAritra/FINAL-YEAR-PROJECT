# ==============================================================================
# Multi-Layer Security Framework for RAG Systems - Environment Configuration
# ==============================================================================
# Copy this file to .env and provide your actual API keys and endpoints.
# NEVER commit .env to version control!

# Groq (Hosted Main LLM & Llama Prompt Guard 2 86M)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Gemini (Gemini Embedding 2 via Google GenAI SDK)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Ollama (Local Main LLM Inference)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b

# Qdrant Cloud (Vector Database)
QDRANT_URL=
QDRANT_API_KEY=

# Application Execution Mode (hosted | local)
MODEL_MODE=hosted

# System & Local Guardrail Settings
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_PRESIDIO=true
PRESIDIO_LANGUAGE=en
ENABLE_SECRET_REGEX=true
